  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\SQL_Upsert_Cleaned_Suppliers"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D7E57F0F-5155-471E-9B88-F81B9F6AB082}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Upsert_Cleaned_Suppliers"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0D655992-8C30-4AA0-BDF2-D4F3CE43F26D}"
          SQLTask:SqlStatementSource="&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    -- STEP 1: UPDATE existing suppliers&#xA;    -- Only update records whose values changed&#xA;&#xA;    UPDATE c&#xA;    SET&#xA;        c.CompanyName = s.CompanyName,&#xA;        c.ContactName = s.ContactName,&#xA;        c.ContactTitle = s.ContactTitle,&#xA;        c.Address = s.Address,&#xA;        c.City = s.City,&#xA;        c.Region = s.Region,&#xA;        c.PostalCode = s.PostalCode,&#xA;        c.Country = s.Country,&#xA;        c.Phone = s.Phone,&#xA;        c.Fax = s.Fax,&#xA;        c.HomePage = s.HomePage&#xA;    FROM cleaned.Suppliers AS c&#xA;    INNER JOIN staging.Suppliers AS s&#xA;        ON c.SupplierID = s.SupplierID&#xA;    WHERE EXISTS&#xA;    (&#xA;        SELECT&#xA;            c.CompanyName, c.ContactName,&#xA;            c.ContactTitle, c.Address,&#xA;            c.City, c.Region, c.PostalCode,&#xA;            c.Country, c.Phone, c.Fax, c.HomePage&#xA;&#xA;        EXCEPT&#xA;&#xA;        SELECT&#xA;            s.CompanyName, s.ContactName,&#xA;            s.ContactTitle, s.Address,&#xA;            s.City, s.Region, s.PostalCode,&#xA;            s.Country, s.Phone, s.Fax, s.HomePage&#xA;    );&#xA;&#xA;    -- STEP 2: INSERT new suppliers&#xA;&#xA;    INSERT INTO cleaned.Suppliers&#xA;    (&#xA;        SupplierID,&#xA;        CompanyName,&#xA;        ContactName,&#xA;        ContactTitle,&#xA;        Address,&#xA;        City,&#xA;        Region,&#xA;        PostalCode,&#xA;        Country,&#xA;        Phone,&#xA;        Fax,&#xA;        HomePage&#xA;    )&#xA;    SELECT&#xA;        s.SupplierID,&#xA;        s.CompanyName,&#xA;        s.ContactName,&#xA;        s.ContactTitle,&#xA;        s.Address,&#xA;        s.City,&#xA;        s.Region,&#xA;        s.PostalCode,&#xA;        s.Country,&#xA;        s.Phone,&#xA;        s.Fax,&#xA;        s.HomePage&#xA;    FROM staging.Suppliers AS s&#xA;    WHERE NOT EXISTS&#xA;    (&#xA;        SELECT 1&#xA;        FROM cleaned.Suppliers AS c&#xA;        WHERE c.SupplierID = s.SupplierID&#xA;    );&#xA;&#xA;    COMMIT TRANSACTION;&#xA;&#xA;END TRY&#xA;&#xA;BEGIN CATCH&#xA;    IF XACT_STATE() &lt;&gt; 0&#xA;        ROLLBACK TRANSACTION;&#xA;&#xA;    THROW;&#xA;END CATCH;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
